{
  "name": "smp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SMP (Safety Management Program) — 건설현장 안전관리 모듈 조합형 데스크톱 프로그램",
  "workspaces": [
    "packages/*",
    "desktop"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "demo": "npm run build && node tools/demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
